# 半个岛 Phase 0 — 本地开发样例（勿提交真实密钥）
# 复制为 half-island/.env 或 apps/api/.env

# API
PORT=8787
HOST=0.0.0.0
DATABASE_PATH=./data/half-island.db
CORS_ORIGIN=http://localhost:5173
ADMIN_TOKEN=dev-admin

# 客户端（Vite）
VITE_API_BASE=http://localhost:8787

# 可选：自由文本答案机翻（OpenAI-compatible 或自建）
# TRANSLATE_API_URL=  # POST {text,target} → {translation|text}
# TRANSLATE_API_KEY=
# TRANSLATE_MODEL=gpt-4o-mini
# TRANSLATE_DISABLE_GOOGLE=1  # 禁用 @vitalets/google-translate-api 后备

# 预留（需主体账号后再填；本阶段勿提交真实值）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# JWT_SECRET=dev-only-change-me
# APPLE_CLIENT_ID=
# PAYMENT_MCH_ID=
