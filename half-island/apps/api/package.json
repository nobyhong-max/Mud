{
  "name": "@half-island/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "tsx --test src/__tests__/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@half-island/shared": "workspace:*",
    "@half-island/content": "workspace:*",
    "fastify": "^5.2.1",
    "@fastify/cors": "^11.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
